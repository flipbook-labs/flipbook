-- Moves the upgrade branch to a new RobloxPackages version and keeps its pull
-- request current. Runs from the upgrade workflow with the upgrade branch
-- checked out, and reads its inputs from the environment:
--
-- - LATEST_VERSION: the RobloxPackages version to upgrade to
-- - BRANCH_NAME: the upgrade branch to push and open the pull request from
-- - GH_TOKEN: a token that can push the branch and edit pull requests
local fs = require("@std/fs")
local process = require("@std/process")

local PROJECT_FILE = "project.luau"
local VERSION_PATTERN = 'ROBLOX_PACKAGES_VERSION = "[^"]*"'
local ENTRY_PATHSPEC = ".changes/upgrade-roblox-packages-*.md"
local BASE_BRANCH = "main"
local REVIEWER = "flipbook-labs/flipbook-engine"

local function assertEnv(name: string): string
	local value = process.env[name]
	assert(value ~= nil and value ~= "", `{name} must be set`)
	return value
end

local function run(command: { string }): string
	local result = process.run(command)
	assert(result.ok, `{table.concat(command, " ")} failed: {result.stderr}`)
	return (result.stdout:gsub("%s+$", ""))
end

local function applyVersion(version: string)
	local source = fs.readFileToString(PROJECT_FILE)
	local updated, count = source:gsub(VERSION_PATTERN, `ROBLOX_PACKAGES_VERSION = "{version}"`)
	assert(count == 1, `Expected one ROBLOX_PACKAGES_VERSION in {PROJECT_FILE}, found {count}`)
	fs.writeStringToFile(PROJECT_FILE, updated)
end

-- An open upgrade branch already carries the entry it added, so later runs
-- rewrite that entry rather than adding a second one.
local function writeChangeEntry(version: string): string
	local added = run({
		"git",
		"diff",
		"--name-only",
		"--diff-filter=A",
		`origin/{BASE_BRANCH}...HEAD`,
		"--",
		ENTRY_PATHSPEC,
	})
	local entryPath = added:match("^[^\n]+") or `.changes/upgrade-roblox-packages-{version}.md`

	fs.writeStringToFile(
		entryPath,
		table.concat({
			"---",
			"bump: patch",
			"category: Dependencies",
			"---",
			"",
			`Upgrade RobloxPackages to {version}.`,
			"",
		}, "\n")
	)

	return entryPath
end

local function renderPullRequestBody(version: string, branch: string): string
	local lines = {
		`This PR upgrades RobloxPackages to **{version}**`,
		"",
		">[!IMPORTANT]",
		"> These changes must be carefully tested in Roblox Studio before merging. The behavior of these packages can and will change out from under us without warning.",
		"",
		"<details>",
		"<summary>Steps to verify</summary>",
		"",
		`1. Fetch this branch: \`git fetch origin {branch}\``,
		"2. Check it out, reusing and fast-forwarding an existing local branch when present:",
		"",
		"   ```sh",
		`   if git show-ref --verify --quiet refs/heads/{branch}; then`,
		`     git switch {branch}`,
		`     git merge --ff-only origin/{branch}`,
		"   else",
		`     git switch --track origin/{branch}`,
		"   fi",
		"   ```",
		"",
		"3. Create the local environment file if needed: `test -f .env || cp .env.template .env`",
		"4. Install dependencies: `lute run install`",
		"5. Build: `lute run build plugin --channel dev --clean`",
		"6. Verify in Roblox Studio that the plugin behaves correctly",
		"",
		"</details>",
	}

	local server, repository, runId =
		process.env.GITHUB_SERVER_URL, process.env.GITHUB_REPOSITORY, process.env.GITHUB_RUN_ID
	if server and repository and runId then
		table.insert(lines, "")
		table.insert(
			lines,
			`_This pull request was generated by [this run]({server}/{repository}/actions/runs/{runId})._`
		)
	end

	return table.concat(lines, "\n")
end

-- Later runs can move an open pull request to a newer version, so its title
-- and body are rewritten every time the branch changes.
local function syncPullRequest(version: string, branch: string)
	local title = `[AUTO-GENERATED] Upgrade RobloxPackages to {version}`
	local body = renderPullRequestBody(version, branch)

	local number = run({
		"gh",
		"pr",
		"list",
		"--head",
		branch,
		"--state",
		"open",
		"--json",
		"number",
		"--jq",
		".[0].number // empty",
	})

	if number ~= "" then
		run({ "gh", "pr", "edit", number, "--title", title, "--body", body })
		print(`Updated pull request #{number}`)
	else
		run({
			"gh",
			"pr",
			"create",
			"--base",
			BASE_BRANCH,
			"--head",
			branch,
			"--title",
			title,
			"--reviewer",
			REVIEWER,
			"--body",
			body,
		})
		print("Opened a pull request")
	end
end

local version = assertEnv("LATEST_VERSION")
local branch = assertEnv("BRANCH_NAME")

applyVersion(version)
local entryPath = writeChangeEntry(version)

if run({ "git", "status", "--porcelain", "--", PROJECT_FILE, entryPath }) == "" then
	print(`The branch already tracks {version}; nothing to push.`)
	return
end

run({ "git", "add", "--", PROJECT_FILE, entryPath })
run({ "git", "commit", "-m", `Upgrade RobloxPackages to {version}` })

-- The new commit is stacked on top of the branch's existing history, so a
-- plain push fast-forwards the remote. If someone pushed to the branch after it
-- was fetched, this push fails rather than clobbering their work, and the job
-- can be re-run.
run({ "git", "push", "origin", branch })

syncPullRequest(version, branch)
